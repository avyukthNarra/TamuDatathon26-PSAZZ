+def flip_episodes(v7c, data_dir, split, keep=None):
+    """Episode ids where v7c's train-learned flip gate fires on this split.
+
+    Reuses FlipGate.swaps: the threshold is the midpoint of the widest gap in
+    the training episodes' log Bayes factors, and an episode fires when its
+    logBF is above that gate and the posterior has a mode tick.
+    """
+    gate = getattr(v7c, "gate", None)
+    if gate is None:
+        return set()
+    from pathlib import Path
+    queries, history = v7c._load(Path(data_dir) / split)
+    if keep is not None:
+        queries = tuple(q for q in queries if q.query_id in keep)
+        keys = {(q.episode_id, q.machine_id) for q in queries}
+        history = tuple(p for p in history if (p.episode_id, p.machine_id) in keys)
+    swaps, _detect = gate.swaps(queries, history, v7c.model.pairs)
+    return set(swaps)
